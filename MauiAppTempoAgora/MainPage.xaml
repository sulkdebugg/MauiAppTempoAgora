<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTempoAgora.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding ="30"
            Spacing="25">

            <Button Text="Minha localização" Clicked="Button_Clicked_Localizacao"/>
            <Label x:Name="lbl_coords"/>

            <Entry x:Name="txt_cidade" Placeholder="Nome da cidade" />
            <Button Text="Buscar Previsão" Clicked="Button_Clicked_Previsao" />
            
            <WebView x:Name="wv_mapa" HeightRequest="400"/>

            <Label x:Name="lbl_res"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
